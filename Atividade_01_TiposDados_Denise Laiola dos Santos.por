programa {
    funcao inicio() {
        // Declaração e inicialização com os tipos do Portugol Studio
        inteiro numeroFilhos = 2
        real precoGasolina = 5.89
        cadeia placaVeiculo = "BRA2E19"
        logico lampadaLigada = verdadeiro
        inteiro distanciaTerraLua = 384400
        caracter letraInicial = 'R'

        escreva("Numero de filhos: ", numeroFilhos, "\n")
        escreva("Preco da gasolina: R$ ", precoGasolina, "\n")
        escreva("Placa do veiculo: ", placaVeiculo, "\n")
        escreva("Lampada esta ligada? ", lampadaLigada, "\n")
        escreva("Distancia Terra-Lua: ", distanciaTerraLua, " km\n")
        escreva("Inicial do nome: ", letraInicial, "\n")
    }
}

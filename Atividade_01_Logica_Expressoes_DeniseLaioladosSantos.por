programa {
    funcao inicio() {
        inteiro a = 5, b = 8, c = 12
        logico d = verdadeiro

        logico exp1 = (a + b > c) e (d == verdadeiro)
        logico exp2 = (c - a == b) ou (b > c)
        logico exp3 = nao (a * 2 > b) e (c > a + b)
        logico exp4 = (b % 2 == 0) e ((a > 10) ou (c / 2 == 6))

        escreva("Resultado Expressao 1: ", exp1, "\n")
        escreva("Resultado Expressao 2: ", exp2, "\n")
        escreva("Resultado Expressao 3: ", exp3, "\n")
        escreva("Resultado Expressao 4: ", exp4, "\n")
    }
}
